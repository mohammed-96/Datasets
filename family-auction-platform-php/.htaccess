<FilesMatch "\.(db|db-journal|db-wal|db-shm|sqlite|sqlite3|sql|bak|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    <IfModule mod_access_compat.c>
      Order allow,deny
      Deny from all
    </IfModule>
  </IfModule>
</FilesMatch>

<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>
